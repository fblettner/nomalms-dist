#!/bin/sh
# nomalms: install and upgrade Nomana products on a customer's server.
#
# The server is enrolled once with a code from the NomaLMS portal. After that,
# each git clone / pull of a product gets a one-hour, read-only GitHub token
# from NomaLMS, as long as the customer's licence for that product is valid.
#
#   nomalms enroll <code> [--url https://...]   register this server (once)
#   nomalms status                              products, licences, installs
#   nomalms install <product> [folder]          clone a product
#   nomalms adopt <folder>                      switch an existing clone to nomalms
#   nomalms upgrade [product|folder|--all]      git pull one product (asks which if several)
#   nomalms license <product>                   print the licence key
#   nomalms self-update                         update this tool
#
# Needs: git, curl. Holds no secret itself; the server token is kept in
# ~/.config/nomalms/config, readable by this user only.

VERSION="1.1.0"
DEFAULT_URL="https://nomalms.nomana-it.fr"
CONF_DIR="${NOMALMS_HOME:-$HOME/.config/nomalms}"
CONF_FILE="$CONF_DIR/config"
INSTALLS_FILE="$CONF_DIR/installs"
TAB="$(printf '\t')"

die()  { echo "nomalms: $*" >&2; exit 1; }
info() { echo "$*" >&2; }

need() { command -v "$1" > /dev/null 2>&1 || die "'$1' is required but not installed"; }

# Absolute path of this script, for the git configuration of the clones.
self_path() {
    case "$0" in
        /*) printf '%s\n' "$0" ;;
        */*) printf '%s/%s\n' "$(cd "$(dirname "$0")" && pwd)" "$(basename "$0")" ;;
        *) command -v "$0" ;;
    esac
}

conf_get() { [ -f "$CONF_FILE" ] && sed -n "s/^$1=//p" "$CONF_FILE" | head -n 1; }

service_url() {
    url="${NOMALMS_URL:-$(conf_get url)}"
    printf '%s\n' "${url:-$DEFAULT_URL}" | sed 's:/*$::'
}

require_token() {
    TOKEN="$(conf_get token)"
    [ -n "$TOKEN" ] || die "this server is not enrolled. In the portal: Repository access > Add a server, then: nomalms enroll <code>"
}

# api METHOD PATH [json-body]  ->  body on stdout; on an error, the service's message and exit 1.
# The token goes to curl on stdin, never on the command line (visible to other users in ps).
api() {
    method="$1"; path="$2"; body="${3:-}"
    out="$(mktemp)" || die "cannot create a temporary file"
    {
        [ -n "${TOKEN:-}" ] && printf 'header = "Authorization: Bearer %s"\n' "$TOKEN"
        printf 'header = "X-Nomalms-Version: %s"\n' "$VERSION"
        [ -n "$body" ] && printf 'header = "Content-Type: application/json"\n'
    } > "$out.cfg"
    if [ -n "$body" ]; then
        code="$(curl -sS -K "$out.cfg" -o "$out" -w '%{http_code}' -X "$method" --data "$body" "$(service_url)$path" 2> "$out.err")"
    else
        code="$(curl -sS -K "$out.cfg" -o "$out" -w '%{http_code}' -X "$method" "$(service_url)$path" 2> "$out.err")"
    fi
    rc=$?
    rm -f "$out.cfg"
    if [ $rc -ne 0 ]; then
        msg="$(cat "$out.err")"; rm -f "$out" "$out.err"
        echo "nomalms: cannot reach $(service_url): $msg" >&2
        return 1
    fi
    rm -f "$out.err"
    if [ "$code" != 200 ] && [ "$code" != 201 ]; then
        msg="$(sed -n 's/.*"detail":"\([^"]*\)".*/\1/p' "$out")"
        rm -f "$out"
        echo "nomalms: ${msg:-the service answered $code}" >&2
        return 1
    fi
    cat "$out"; rm -f "$out"
}

# ── Commands ──────────────────────────────────────────────────────────────

cmd_enroll() {
    code=""; url=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --url) url="$2"; shift 2 ;;
            --url=*) url="${1#--url=}"; shift ;;
            *) code="$1"; shift ;;
        esac
    done
    [ -n "$code" ] || die "usage: nomalms enroll <code> [--url https://...]"
    code="$(printf '%s' "$code" | tr -cd 'A-Za-z0-9-')"
    host="$(hostname 2> /dev/null | tr -cd 'A-Za-z0-9._-')"
    [ -n "$url" ] && NOMALMS_URL="$url"
    TOKEN=""
    answer="$(api POST "/api/server/enroll?format=text" "{\"code\":\"$code\",\"hostname\":\"$host\",\"version\":\"$VERSION\"}")" || exit 1
    token="$(printf '%s\n' "$answer" | sed -n 's/^token=//p')"
    [ -n "$token" ] || die "unexpected answer from the service"
    mkdir -p "$CONF_DIR" && chmod 700 "$CONF_DIR"
    ( umask 077; printf 'url=%s\ntoken=%s\n' "$(service_url)" "$token" > "$CONF_FILE" )
    chmod 600 "$CONF_FILE"
    echo "Enrolled as '$(printf '%s\n' "$answer" | sed -n 's/^server=//p')' for $(printf '%s\n' "$answer" | sed -n 's/^customer=//p')."
    echo "Next: nomalms status"
}

# Lines "name<TAB>repo<TAB>valid|invalid<TAB>expiry<TAB>label" of the products.
products() { printf '%s\n' "$STATUS" | sed -n "s/^product$TAB//p"; }

load_status() { require_token; STATUS="$(api GET "/api/server/status?format=text")" || exit 1; }

cmd_status() {
    load_status
    echo "Service : $(service_url)"
    echo "Server  : $(printf '%s\n' "$STATUS" | sed -n 's/^server=//p')"
    echo "Customer: $(printf '%s\n' "$STATUS" | sed -n 's/^customer=//p')"
    echo
    echo "Products:"
    if [ -z "$(products)" ]; then echo "  (no licence)"; fi
    products | while IFS="$TAB" read -r name repo valid expires label; do
        case "$valid" in valid) state="licence valid" ;; *) state="NO VALID LICENCE" ;; esac
        [ "$expires" = "-" ] || state="$state until $expires"
        [ "$repo" = "-" ] && repo="(not distributed through nomalms)"
        printf '  %-16s %s\n    %s, %s\n' "$name" "$label" "$repo" "$state"
    done
    echo
    echo "Installed here:"
    if [ -s "$INSTALLS_FILE" ]; then
        while IFS="$TAB" read -r name dir; do
            if [ -d "$dir/.git" ]; then
                printf '  %-16s %s  (%s)\n' "$name" "$dir" "$(git -C "$dir" describe --tags --always 2> /dev/null)"
            else
                printf '  %-16s %s  (folder missing)\n' "$name" "$dir"
            fi
        done < "$INSTALLS_FILE"
    else
        echo "  (nothing yet: nomalms install <product> [folder])"
    fi
}

# repo_of PRODUCT -> owner/name, after checking the licence.
repo_of() {
    line="$(products | awk -F "$TAB" -v p="$1" '$1 == p')"
    [ -n "$line" ] || die "no licence for the product '$1' (see: nomalms status)"
    repo="$(printf '%s\n' "$line" | cut -f 2)"
    [ "$repo" != "-" ] || die "'$1' is not distributed through nomalms"
    [ "$(printf '%s\n' "$line" | cut -f 3)" = valid ] || die "the licence for '$1' has expired or been revoked"
    printf '%s\n' "$repo"
}

# What git is told, per clone: ignore other helpers, ask this tool, and say which repository.
helper_value() { printf "!'%s' git-credential" "$(self_path)"; }

configure_clone() {
    git -C "$1" config --unset-all credential.helper 2> /dev/null
    git -C "$1" config --add credential.helper ""
    git -C "$1" config --add credential.helper "$(helper_value)"
    git -C "$1" config credential.useHttpPath true
}

record_install() {
    mkdir -p "$CONF_DIR"
    touch "$INSTALLS_FILE"
    grep -v "$TAB$2\$" "$INSTALLS_FILE" > "$INSTALLS_FILE.tmp" 2> /dev/null
    printf '%s\t%s\n' "$1" "$2" >> "$INSTALLS_FILE.tmp"
    mv "$INSTALLS_FILE.tmp" "$INSTALLS_FILE"
}

next_step() {
    case "$1" in
        nomaubl*) echo "Next, for each environment: ./nomaubl.sh upgrade <env>   (in $2)" ;;
        *) echo "Next: follow the product's README in $2 to install the new version." ;;
    esac
}

cmd_install() {
    [ $# -ge 1 ] || die "usage: nomalms install <product> [folder]"
    need git
    load_status
    repo="$(repo_of "$1")" || exit 1
    dir="${2:-$(basename "$repo")}"
    [ ! -e "$dir" ] || die "'$dir' already exists. For an existing install: nomalms adopt $dir"
    git clone -c credential.helper= -c "credential.helper=$(helper_value)" -c credential.useHttpPath=true \
        "https://github.com/$repo.git" "$dir" || die "the clone failed"
    dir="$(cd "$dir" && pwd)"
    configure_clone "$dir"
    record_install "$1" "$dir"
    echo "Installed $1 in $dir."
    echo "Licence key to enter in the product: nomalms license $1"
}

cmd_adopt() {
    [ $# -ge 1 ] || die "usage: nomalms adopt <folder>"
    need git
    [ -d "$1/.git" ] || die "'$1' is not a git clone"
    dir="$(cd "$1" && pwd)"
    old_url="$(git -C "$dir" remote get-url origin 2> /dev/null)" || die "'$dir' has no remote named origin"
    # https://github.com/owner/name(.git) or git@host-or-alias:owner/name(.git)
    repo="$(printf '%s\n' "$old_url" | sed -e 's/\.git$//' -e 's#^https\{0,1\}://[^/]*/##' -e 's#^[^:/]*@[^:]*:##' -e 's#^ssh://[^/]*/##')"
    load_status
    line="$(products | awk -F "$TAB" -v r="$repo" 'tolower($2) == tolower(r)')"
    [ -n "$line" ] || die "'$repo' is not one of your products distributed through nomalms (see: nomalms status)"
    name="$(printf '%s\n' "$line" | cut -f 1)"
    old_helpers="$(git -C "$dir" config --local --get-all credential.helper 2> /dev/null)"
    old_path="$(git -C "$dir" config --local --get credential.useHttpPath 2> /dev/null)"
    git -C "$dir" remote set-url origin "https://github.com/$repo.git"
    configure_clone "$dir"
    if git -C "$dir" fetch --quiet origin; then
        record_install "$name" "$dir"
        echo "$dir now pulls $repo through nomalms."
        echo "The token or deploy key used before is no longer needed on this server."
    else
        # Put everything back: the previous way keeps working.
        git -C "$dir" remote set-url origin "$old_url"
        git -C "$dir" config --unset-all credential.helper 2> /dev/null
        printf '%s\n' "$old_helpers" | while IFS= read -r h; do
            [ -n "$h" ] && git -C "$dir" config --add credential.helper "$h"
        done
        if [ -n "$old_path" ]; then git -C "$dir" config credential.useHttpPath "$old_path"
        else git -C "$dir" config --unset credential.useHttpPath 2> /dev/null; fi
        die "could not fetch through nomalms; '$dir' was left as it was"
    fi
}

upgrade_one() {
    name="$1"; dir="$2"
    [ -d "$dir/.git" ] || { info "nomalms: $dir is missing, skipped"; return 1; }
    before="$(git -C "$dir" rev-parse HEAD 2> /dev/null)"
    echo "== $name ($dir)"
    git -C "$dir" pull --ff-only || { info "nomalms: the pull failed in $dir"; return 1; }
    if [ "$before" = "$(git -C "$dir" rev-parse HEAD)" ]; then
        echo "Already up to date ($(git -C "$dir" describe --tags --always 2> /dev/null))."
    else
        echo "Now at $(git -C "$dir" describe --tags --always 2> /dev/null)."
        next_step "$name" "$dir"
    fi
}

cmd_upgrade() {
    need git
    [ -s "$INSTALLS_FILE" ] || die "nothing installed through nomalms yet (nomalms install, or nomalms adopt <folder>)"
    target="${1:-}"
    count="$(grep -c . "$INSTALLS_FILE")"
    if [ -z "$target" ] && [ "$count" -gt 1 ]; then
        # Several products on this server: never pull them all without being asked.
        info "Several products are installed on this server:"
        n=0
        while IFS="$TAB" read -r name dir <&3; do n=$((n + 1)); info "  $n) $name  ($dir)"; done 3< "$INSTALLS_FILE"
        [ -t 0 ] || die "say which one: nomalms upgrade <product|folder>, or nomalms upgrade --all"
        printf 'Which one to upgrade? [1-%s, a = all, Enter = none] ' "$count" >&2
        read -r answer || answer=""
        case "$answer" in
            a|A|all) target="--all" ;;
            ''|*[!0-9]*) die "nothing upgraded" ;;
            *)
                { [ "$answer" -ge 1 ] && [ "$answer" -le "$count" ]; } || die "nothing upgraded: '$answer' is not in the list"
                target="$(grep . "$INSTALLS_FILE" | sed -n "${answer}p" | cut -f 2)" ;;
        esac
    fi
    failed=0
    if [ -z "$target" ] || [ "$target" = "--all" ]; then
        while IFS="$TAB" read -r name dir <&3; do upgrade_one "$name" "$dir" || failed=1; done 3< "$INSTALLS_FILE"
    else
        [ -d "$target" ] && target="$(cd "$target" && pwd)"
        found=0
        while IFS="$TAB" read -r name dir <&3; do
            if [ "$name" = "$target" ] || [ "$dir" = "$target" ]; then
                found=1; upgrade_one "$name" "$dir" || failed=1
            fi
        done 3< "$INSTALLS_FILE"
        [ $found -eq 1 ] || die "'$1' is not installed through nomalms (see: nomalms status)"
    fi
    exit $failed
}

cmd_license() {
    [ $# -ge 1 ] || die "usage: nomalms license <product>"
    require_token
    api GET "/api/server/license?product=$(printf '%s' "$1" | tr -cd 'A-Za-z0-9._-')&format=text" || exit 1
}

# Called by git: "git-credential get" with the request on stdin.
cmd_git_credential() {
    [ "${1:-}" = get ] || exit 0
    host=""; path=""
    while IFS= read -r line; do
        case "$line" in
            host=*) host="${line#host=}" ;;
            path=*) path="${line#path=}" ;;
        esac
    done
    [ "$host" = github.com ] || exit 0
    TOKEN="$(conf_get token)"
    [ -n "$TOKEN" ] || { info "nomalms: this server is not enrolled (nomalms enroll <code>)"; exit 0; }
    repo="$(printf '%s' "${path%.git}" | tr -cd 'A-Za-z0-9._/-')"
    api POST "/api/git-credential?format=git&repo=$repo" || exit 0
}

cmd_self_update() {
    need git
    here="$(dirname "$(self_path)")"
    [ -d "$here/.git" ] || die "$here is not a git clone: download the new version by hand"
    git -C "$here" pull --ff-only && echo "nomalms $("$(self_path)" version)"
}

usage() { sed -n '2,/^$/p' "$0" | sed -e 's/^# \{0,1\}//' -e '/^Needs:/,$d'; }

need curl
cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
    enroll) cmd_enroll "$@" ;;
    status) cmd_status ;;
    install) cmd_install "$@" ;;
    adopt) cmd_adopt "$@" ;;
    upgrade|update) cmd_upgrade "$@" ;;
    license|licence) cmd_license "$@" ;;
    git-credential) cmd_git_credential "$@" ;;
    self-update) cmd_self_update ;;
    version|--version|-v) echo "$VERSION" ;;
    help|--help|-h) usage ;;
    *) die "unknown command '$cmd' (nomalms help)" ;;
esac
