#!/bin/sh
# nomalms: install and upgrade Nomana products on a customer's server.
#
# The server is enrolled once with a code from the NomaLMS portal. After that,
# each git clone / pull of a product gets a one-hour, read-only GitHub token
# from NomaLMS, as long as the customer's licence for that product is valid.
#
#   nomalms enroll <code> [--url https://...]   register this server (once)
#   nomalms status                              products, licences, installs
#   nomalms install <product> [folder]          clone a product
#   nomalms adopt <folder>                      switch an existing clone to nomalms
#   nomalms upgrade [product|folder|--all]      git pull one product (asks which if several)
#           [--apply] [--env <name>]...         ... then upgrade the application itself
#   nomalms set <product|folder> [key value]    settings of an install (apply, envs, mode, ...)
#   nomalms license <product>                   print the licence key
#   nomalms self-update                         update this tool
#
# Needs: git, curl. Holds no secret itself; the server token is kept in
# ~/.config/nomalms/config, readable by this user only.

VERSION="1.2.1"
DEFAULT_URL="https://nomalms.nomana-it.fr"
CONF_DIR="${NOMALMS_HOME:-$HOME/.config/nomalms}"
CONF_FILE="$CONF_DIR/config"
INSTALLS_FILE="$CONF_DIR/installs"
TAB="$(printf '\t')"

die()  { echo "nomalms: $*" >&2; exit 1; }
info() { echo "$*" >&2; }

need() { command -v "$1" > /dev/null 2>&1 || die "'$1' is required but not installed"; }

# Absolute path of this script, for the git configuration of the clones.
self_path() {
    case "$0" in
        /*) printf '%s\n' "$0" ;;
        */*) printf '%s/%s\n' "$(cd "$(dirname "$0")" && pwd)" "$(basename "$0")" ;;
        *) command -v "$0" ;;
    esac
}

conf_get() { [ -f "$CONF_FILE" ] && sed -n "s/^$1=//p" "$CONF_FILE" | head -n 1; }

service_url() {
    url="${NOMALMS_URL:-$(conf_get url)}"
    printf '%s\n' "${url:-$DEFAULT_URL}" | sed 's:/*$::'
}

require_token() {
    TOKEN="$(conf_get token)"
    [ -n "$TOKEN" ] || die "this server is not enrolled. In the portal: Repository access > Add a server, then: nomalms enroll <code>"
}

# api METHOD PATH [json-body]  ->  body on stdout; on an error, the service's message and exit 1.
# The token goes to curl on stdin, never on the command line (visible to other users in ps).
api() {
    method="$1"; path="$2"; body="${3:-}"
    out="$(mktemp)" || die "cannot create a temporary file"
    {
        [ -n "${TOKEN:-}" ] && printf 'header = "Authorization: Bearer %s"\n' "$TOKEN"
        printf 'header = "X-Nomalms-Version: %s"\n' "$VERSION"
        [ -n "$body" ] && printf 'header = "Content-Type: application/json"\n'
    } > "$out.cfg"
    if [ -n "$body" ]; then
        code="$(curl -sS -K "$out.cfg" -o "$out" -w '%{http_code}' -X "$method" --data "$body" "$(service_url)$path" 2> "$out.err")"
    else
        code="$(curl -sS -K "$out.cfg" -o "$out" -w '%{http_code}' -X "$method" "$(service_url)$path" 2> "$out.err")"
    fi
    rc=$?
    rm -f "$out.cfg"
    if [ $rc -ne 0 ]; then
        msg="$(cat "$out.err")"; rm -f "$out" "$out.err"
        echo "nomalms: cannot reach $(service_url): $msg" >&2
        return 1
    fi
    rm -f "$out.err"
    if [ "$code" != 200 ] && [ "$code" != 201 ]; then
        msg="$(sed -n 's/.*"detail":"\([^"]*\)".*/\1/p' "$out")"
        rm -f "$out"
        echo "nomalms: ${msg:-the service answered $code}" >&2
        return 1
    fi
    cat "$out"; rm -f "$out"
}

# ── Commands ──────────────────────────────────────────────────────────────

cmd_enroll() {
    code=""; url=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --url) url="$2"; shift 2 ;;
            --url=*) url="${1#--url=}"; shift ;;
            *) code="$1"; shift ;;
        esac
    done
    [ -n "$code" ] || die "usage: nomalms enroll <code> [--url https://...]"
    code="$(printf '%s' "$code" | tr -cd 'A-Za-z0-9-')"
    host="$(hostname 2> /dev/null | tr -cd 'A-Za-z0-9._-')"
    [ -n "$url" ] && NOMALMS_URL="$url"
    TOKEN=""
    answer="$(api POST "/api/server/enroll?format=text" "{\"code\":\"$code\",\"hostname\":\"$host\",\"version\":\"$VERSION\"}")" || exit 1
    token="$(printf '%s\n' "$answer" | sed -n 's/^token=//p')"
    [ -n "$token" ] || die "unexpected answer from the service"
    mkdir -p "$CONF_DIR" && chmod 700 "$CONF_DIR"
    ( umask 077; printf 'url=%s\ntoken=%s\n' "$(service_url)" "$token" > "$CONF_FILE" )
    chmod 600 "$CONF_FILE"
    echo "Enrolled as '$(printf '%s\n' "$answer" | sed -n 's/^server=//p')' for $(printf '%s\n' "$answer" | sed -n 's/^customer=//p')."
    echo "Next: nomalms status"
}

# Lines "name<TAB>repo<TAB>valid|invalid<TAB>expiry<TAB>label" of the products.
products() { printf '%s\n' "$STATUS" | sed -n "s/^product$TAB//p"; }

load_status() { require_token; STATUS="$(api GET "/api/server/status?format=text")" || exit 1; }

cmd_status() {
    load_status
    echo "Service : $(service_url)"
    echo "Server  : $(printf '%s\n' "$STATUS" | sed -n 's/^server=//p')"
    echo "Customer: $(printf '%s\n' "$STATUS" | sed -n 's/^customer=//p')"
    echo
    echo "Products:"
    if [ -z "$(products)" ]; then echo "  (no licence)"; fi
    products | while IFS="$TAB" read -r name repo valid expires label; do
        case "$valid" in valid) state="licence valid" ;; *) state="NO VALID LICENCE" ;; esac
        [ "$expires" = "-" ] || state="$state until $expires"
        [ "$repo" = "-" ] && repo="(not distributed through nomalms)"
        printf '  %-16s %s\n    %s, %s\n' "$name" "$label" "$repo" "$state"
    done
    echo
    echo "Installed here:"
    if [ -s "$INSTALLS_FILE" ]; then
        while IFS="$TAB" read -r name dir; do
            if [ -d "$dir/.git" ]; then
                printf '  %-16s %s  (%s)\n' "$name" "$dir" "$(git_at "$dir" describe --tags --always 2> /dev/null)"
            else
                printf '  %-16s %s  (folder missing)\n' "$name" "$dir"
            fi
        done < "$INSTALLS_FILE"
    else
        echo "  (nothing yet: nomalms install <product> [folder])"
    fi
}

# repo_of PRODUCT -> owner/name, after checking the licence.
repo_of() {
    line="$(products | awk -F "$TAB" -v p="$1" '$1 == p')"
    [ -n "$line" ] || die "no licence for the product '$1' (see: nomalms status)"
    repo="$(printf '%s\n' "$line" | cut -f 2)"
    [ "$repo" != "-" ] || die "'$1' is not distributed through nomalms"
    [ "$(printf '%s\n' "$line" | cut -f 3)" = valid ] || die "the licence for '$1' has expired or been revoked"
    printf '%s\n' "$repo"
}

# What git is told, per clone: ignore other helpers, ask this tool, and say which repository.
helper_value() { printf "!'%s' git-credential" "$(self_path)"; }

# git_at FOLDER ARGS...: git in that folder (no "git -C": it needs git 1.8.5).
git_at() { ( cd "$1" && shift && git "$@" ); }

# Before git 2.9 an empty credential.helper does not reset the list of helpers: leave it out.
git_resets_helpers() {
    v="$(git --version | sed 's/[^0-9]*\([0-9]*\)\.\([0-9]*\).*/\1 \2/')"
    # shellcheck disable=SC2086
    set -- $v
    [ "${1:-0}" -gt 2 ] || { [ "${1:-0}" -eq 2 ] && [ "${2:-0}" -ge 9 ]; }
}

# Git refuses a folder owned by another user unless it is declared safe.
owner_hint() {
    owner="$(ls -ld "$1" | awk '{print $3}')"
    echo "'$1' belongs to $owner, and you are $(id -un). Either run nomalms as $owner (enrol as $owner too: the enrolment is per user), or allow it for this user: git config --global --add safe.directory $1"
}

configure_clone() {
    git_at "$1" config --unset-all credential.helper 2> /dev/null
    if git_resets_helpers; then git_at "$1" config --add credential.helper ""; fi
    git_at "$1" config --add credential.helper "$(helper_value)"
    git_at "$1" config credential.useHttpPath true
}

record_install() {
    mkdir -p "$CONF_DIR"
    touch "$INSTALLS_FILE"
    grep -v "$TAB$2\$" "$INSTALLS_FILE" > "$INSTALLS_FILE.tmp" 2> /dev/null
    printf '%s\t%s\n' "$1" "$2" >> "$INSTALLS_FILE.tmp"
    mv "$INSTALLS_FILE.tmp" "$INSTALLS_FILE"
}

# ---- settings per install: folder <TAB> key <TAB> value --------------------------------
SETTINGS_FILE="$CONF_DIR/settings"
SETTING_KEYS="apply envs mode liberty_dir target"

setting() { [ -f "$SETTINGS_FILE" ] && awk -F "$TAB" -v d="$1" -v k="$2" '$1 == d && $2 == k { print $3 }' "$SETTINGS_FILE" | tail -n 1; }

# install_of PRODUCT|FOLDER -> "name<TAB>folder" of the one install meant.
install_of() {
    [ -s "$INSTALLS_FILE" ] || die "nothing installed through nomalms yet"
    t="$1"; [ -d "$t" ] && t="$(cd "$t" && pwd)"
    found="$(awk -F "$TAB" -v t="$t" '$1 == t || $2 == t' "$INSTALLS_FILE")"
    [ -n "$found" ] || die "'$1' is not installed through nomalms (see: nomalms status)"
    [ "$(printf '%s\n' "$found" | grep -c .)" -eq 1 ] || die "'$1' is installed in several folders: give the folder"
    printf '%s\n' "$found"
}

cmd_set() {
    [ $# -ge 1 ] || die "usage: nomalms set <product|folder> [<key> <value>]   keys: $SETTING_KEYS"
    entry="$(install_of "$1")" || exit 1
    dir="$(printf '%s\n' "$entry" | cut -f 2)"
    if [ $# -eq 1 ]; then
        echo "Settings of $dir:"
        for k in $SETTING_KEYS; do
            v="$(setting "$dir" "$k")"; [ -n "$v" ] && printf '  %-12s %s\n' "$k" "$v"
        done
        return 0
    fi
    [ $# -ge 3 ] || die "usage: nomalms set <product|folder> <key> <value>"
    key="$2"; shift 2; value="$*"
    case " $SETTING_KEYS " in *" $key "*) ;; *) die "unknown setting '$key' (one of: $SETTING_KEYS)" ;; esac
    case "$key" in
        apply) case "$value" in yes|no) ;; *) die "apply is yes or no" ;; esac ;;
        mode) case "$value" in docker|python) ;; *) die "mode is docker or python" ;; esac ;;
        liberty_dir) [ -x "$value/liberty" ] || die "'$value' does not hold the 'liberty' script (give the liberty-next release folder)"
            value="$(cd "$value" && pwd)" ;;
    esac
    case "$value" in *"$TAB"*) die "a value cannot contain a tab" ;; esac
    mkdir -p "$CONF_DIR"; touch "$SETTINGS_FILE"
    awk -F "$TAB" -v d="$dir" -v k="$key" '!($1 == d && $2 == k)' "$SETTINGS_FILE" > "$SETTINGS_FILE.tmp"
    printf '%s\t%s\t%s\n' "$dir" "$key" "$value" >> "$SETTINGS_FILE.tmp"
    mv "$SETTINGS_FILE.tmp" "$SETTINGS_FILE"
    echo "$key = $value   ($dir)"
}

# ---- upgrading the application after the pull ------------------------------------------
# The products' own, documented procedures. Which one applies is told by the repository.
product_kind() {
    case "$(git_at "$1" config --get remote.origin.url 2> /dev/null | sed -e 's/\.git$//' -e 's#.*/##')" in
        nomaubl-dist) echo nomaubl ;;
        liberty-apps-dist) echo liberty ;;
        *) echo unknown ;;
    esac
}

# The environments of a NomaUBL install: the folders holding config/config.json.
nomaubl_envs() {
    home="$( [ -f "$1/nomaubl.conf" ] && . "$1/nomaubl.conf" > /dev/null 2>&1; printf '%s' "${ENV_HOME:-}" )"
    case "$home" in '') home="$1" ;; /*) ;; *) home="$1/$home" ;; esac
    for cfg in "$home"/*/config/config.json; do
        [ -f "$cfg" ] && basename "$(dirname "$(dirname "$cfg")")"
    done
}

apply_nomaubl() {
    dir="$1"
    envs="${CLI_ENVS:-$(setting "$dir" envs)}"
    known="$(nomaubl_envs "$dir" | tr '\n' ' ')"
    # Never a default: test and production are not upgraded together by accident.
    if [ -z "$(printf '%s' "$envs" | tr -d ' ')" ]; then
        info "nomalms: say which environment to upgrade: nomalms upgrade <product> --apply --env <name>"
        info "         found in $dir: ${known:-none}"
        return 1
    fi
    for env in $envs; do
        case " $known " in *" $env "*) ;; *) info "nomalms: no environment '$env' in $dir (found: ${known:-none}); nothing was upgraded"; return 1 ;; esac
    done
    echo "Environments to upgrade: $envs"
    for env in $envs; do
        echo "-- ./nomaubl.sh upgrade $env"
        ( cd "$dir" && ./nomaubl.sh upgrade "$env" ) || {
            info "nomalms: the upgrade of '$env' failed; the environments after it were not touched"
            return 1
        }
    done
}

apply_liberty() {
    dir="$1"
    wheel="$dir/$(head -n 1 "$dir/LATEST" 2> /dev/null | tr -d '[:space:]')"
    [ -f "$wheel" ] || { info "nomalms: LATEST does not name a wheel present in $dir"; return 1; }
    if [ -f "$dir/SHA256SUMS" ]; then
        sum="$(grep "[ *]$(basename "$wheel")\$" "$dir/SHA256SUMS")"
        if [ -n "$sum" ]; then
            if command -v sha256sum > /dev/null 2>&1; then check="sha256sum -c -"; else check="shasum -a 256 -c -"; fi
            ( cd "$dir" && printf '%s\n' "$sum" | $check > /dev/null 2>&1 ) || { info "nomalms: $(basename "$wheel") does not match SHA256SUMS"; return 1; }
        fi
    fi
    case "$(setting "$dir" mode)" in
        docker)
            ldir="$(setting "$dir" liberty_dir)"
            [ -x "$ldir/liberty" ] || { info "nomalms: say where liberty-next's release folder is: nomalms set $dir liberty_dir <folder>"; return 1; }
            echo "-- ./liberty apps $wheel   (in $ldir)"
            ( cd "$ldir" && ./liberty apps "$wheel" ) ;;
        python)
            target="$(setting "$dir" target)"; target="${target:-/opt/liberty/apps/config}"
            echo "-- pipx inject --force liberty-next $wheel"
            pipx inject --force liberty-next "$wheel" || return 1
            echo "-- liberty-apps install --target $target"
            liberty-apps install --target "$target" || return 1
            echo "-- liberty-ops migrate"
            liberty-ops migrate ;;
        *)
            info "nomalms: say how Liberty runs here, once: nomalms set $dir mode docker   (or: python)"
            return 1 ;;
    esac
}

apply_app() {
    case "$(product_kind "$1")" in
        nomaubl) apply_nomaubl "$1" ;;
        liberty) apply_liberty "$1" ;;
        *) info "nomalms: no upgrade procedure is built in for this product; follow its README in $1"; return 1 ;;
    esac
}

next_step() {
    echo "The files are up to date; the application itself was not upgraded."
    echo "To do it: nomalms upgrade $1 --apply   (always after a pull: nomalms set $1 apply yes)"
}

cmd_install() {
    [ $# -ge 1 ] || die "usage: nomalms install <product> [folder]"
    need git
    load_status
    repo="$(repo_of "$1")" || exit 1
    dir="${2:-$(basename "$repo")}"
    [ ! -e "$dir" ] || die "'$dir' already exists. For an existing install: nomalms adopt $dir"
    if git_resets_helpers; then reset="-c credential.helper="; else reset=""; fi
    # shellcheck disable=SC2086
    git clone $reset -c "credential.helper=$(helper_value)" -c credential.useHttpPath=true \
        "https://github.com/$repo.git" "$dir" || die "the clone failed"
    dir="$(cd "$dir" && pwd)"
    configure_clone "$dir"
    record_install "$1" "$dir"
    echo "Installed $1 in $dir."
    echo "Licence key to enter in the product: nomalms license $1"
}

cmd_adopt() {
    [ $# -ge 1 ] || die "usage: nomalms adopt <folder>"
    need git
    [ -d "$1/.git" ] || die "'$1' is not a git clone"
    dir="$(cd "$1" && pwd)"
    mkdir -p "$CONF_DIR"
    # Not "git remote get-url": it needs git 2.7.
    old_url="$(git_at "$dir" config --get remote.origin.url 2> "$CONF_DIR/.git-error")" || {
        reason="$(cat "$CONF_DIR/.git-error" 2> /dev/null)"; rm -f "$CONF_DIR/.git-error"
        case "$reason" in *dubious*|*safe.directory*) die "$(owner_hint "$dir")" ;; esac
        [ -z "$reason" ] || die "git cannot read '$dir': $reason"
        die "'$dir' has no remote named origin"
    }
    rm -f "$CONF_DIR/.git-error"
    # https://github.com/owner/name(.git) or git@host-or-alias:owner/name(.git)
    repo="$(printf '%s\n' "$old_url" | sed -e 's/\.git$//' -e 's#^https\{0,1\}://[^/]*/##' -e 's#^[^:/]*@[^:]*:##' -e 's#^ssh://[^/]*/##')"
    load_status
    line="$(products | awk -F "$TAB" -v r="$repo" 'tolower($2) == tolower(r)')"
    [ -n "$line" ] || die "'$repo' is not one of your products distributed through nomalms (see: nomalms status)"
    name="$(printf '%s\n' "$line" | cut -f 1)"
    old_helpers="$(git_at "$dir" config --local --get-all credential.helper 2> /dev/null)"
    old_path="$(git_at "$dir" config --local --get credential.useHttpPath 2> /dev/null)"
    git_at "$dir" remote set-url origin "https://github.com/$repo.git"
    configure_clone "$dir"
    if git_at "$dir" fetch --quiet origin; then
        record_install "$name" "$dir"
        echo "$dir now pulls $repo through nomalms."
        echo "The token or deploy key used before is no longer needed on this server."
    else
        # Put everything back: the previous way keeps working.
        git_at "$dir" remote set-url origin "$old_url"
        git_at "$dir" config --unset-all credential.helper 2> /dev/null
        printf '%s\n' "$old_helpers" | while IFS= read -r h; do
            [ -n "$h" ] && git_at "$dir" config --add credential.helper "$h"
        done
        if [ -n "$old_path" ]; then git_at "$dir" config credential.useHttpPath "$old_path"
        else git_at "$dir" config --unset credential.useHttpPath 2> /dev/null; fi
        die "could not fetch through nomalms; '$dir' was left as it was"
    fi
}

upgrade_one() {
    name="$1"; dir="$2"
    [ -d "$dir/.git" ] || { info "nomalms: $dir is missing, skipped"; return 1; }
    before="$(git_at "$dir" rev-parse HEAD 2> /dev/null)"
    echo "== $name ($dir)"
    git_at "$dir" pull --ff-only || { info "nomalms: the pull failed in $dir"; return 1; }
    if [ "$before" = "$(git_at "$dir" rev-parse HEAD)" ]; then
        echo "Already up to date ($(git_at "$dir" describe --tags --always 2> /dev/null))."
        # Nothing new: the application is only upgraded when asked for on the command line.
        [ "$CLI_APPLY" = yes ] || return 0
    else
        echo "Now at $(git_at "$dir" describe --tags --always 2> /dev/null)."
        if [ "$CLI_APPLY" != yes ] && [ "$(setting "$dir" apply)" != yes ]; then
            next_step "$name"
            return 0
        fi
    fi
    # $name and $dir are reused by the procedures: keep ours.
    ( apply_app "$dir" ) || { info "nomalms: $name was pulled, but its upgrade did not complete"; return 1; }
    echo "$name is upgraded."
}

cmd_upgrade() {
    need git
    [ -s "$INSTALLS_FILE" ] || die "nothing installed through nomalms yet (nomalms install, or nomalms adopt <folder>)"
    target=""; CLI_APPLY=no; CLI_ENVS=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --apply) CLI_APPLY=yes ;;
            --env) [ $# -ge 2 ] || die "--env needs a name"; CLI_ENVS="$CLI_ENVS $2"; shift ;;
            --all) target="--all" ;;
            -*) die "unknown option '$1'" ;;
            *) [ -z "$target" ] || die "one product at a time (or --all)"; target="$1" ;;
        esac
        shift
    done
    asked="$target"
    count="$(grep -c . "$INSTALLS_FILE")"
    if [ -z "$target" ] && [ "$count" -gt 1 ]; then
        # Several products on this server: never pull them all without being asked.
        info "Several products are installed on this server:"
        n=0
        while IFS="$TAB" read -r name dir <&3; do n=$((n + 1)); info "  $n) $name  ($dir)"; done 3< "$INSTALLS_FILE"
        [ -t 0 ] || die "say which one: nomalms upgrade <product|folder>, or nomalms upgrade --all"
        printf 'Which one to upgrade? [1-%s, a = all, Enter = none] ' "$count" >&2
        read -r answer || answer=""
        case "$answer" in
            a|A|all) target="--all" ;;
            ''|*[!0-9]*) die "nothing upgraded" ;;
            *)
                { [ "$answer" -ge 1 ] && [ "$answer" -le "$count" ]; } || die "nothing upgraded: '$answer' is not in the list"
                target="$(grep . "$INSTALLS_FILE" | sed -n "${answer}p" | cut -f 2)" ;;
        esac
    fi
    failed=0
    if [ -z "$target" ] || [ "$target" = "--all" ]; then
        while IFS="$TAB" read -r name dir <&3; do upgrade_one "$name" "$dir" || failed=1; done 3< "$INSTALLS_FILE"
    else
        [ -d "$target" ] && target="$(cd "$target" && pwd)"
        found=0
        while IFS="$TAB" read -r name dir <&3; do
            if [ "$name" = "$target" ] || [ "$dir" = "$target" ]; then
                found=1; upgrade_one "$name" "$dir" || failed=1
            fi
        done 3< "$INSTALLS_FILE"
        [ $found -eq 1 ] || die "'$asked' is not installed through nomalms (see: nomalms status)"
    fi
    exit $failed
}

cmd_license() {
    [ $# -ge 1 ] || die "usage: nomalms license <product>"
    require_token
    api GET "/api/server/license?product=$(printf '%s' "$1" | tr -cd 'A-Za-z0-9._-')&format=text" || exit 1
}

# Called by git: "git-credential get" with the request on stdin.
cmd_git_credential() {
    [ "${1:-}" = get ] || exit 0
    host=""; path=""
    while IFS= read -r line; do
        case "$line" in
            host=*) host="${line#host=}" ;;
            path=*) path="${line#path=}" ;;
        esac
    done
    [ "$host" = github.com ] || exit 0
    TOKEN="$(conf_get token)"
    [ -n "$TOKEN" ] || { info "nomalms: this server is not enrolled (nomalms enroll <code>)"; exit 0; }
    repo="$(printf '%s' "${path%.git}" | tr -cd 'A-Za-z0-9._/-')"
    api POST "/api/git-credential?format=git&repo=$repo" || exit 0
}

cmd_self_update() {
    need git
    # The command is usually a link (/usr/local/bin/nomalms): follow it to the clone.
    file="$(self_path)"
    while [ -L "$file" ]; do
        target="$(readlink "$file")"
        case "$target" in /*) file="$target" ;; *) file="$(dirname "$file")/$target" ;; esac
    done
    here="$(cd "$(dirname "$file")" && pwd)"
    [ -d "$here/.git" ] || die "$here is not a git clone: download the new version by hand"
    git_at "$here" pull --ff-only && echo "nomalms $("$(self_path)" version)"
}

usage() { sed -n '2,/^$/p' "$0" | sed -e 's/^# \{0,1\}//' -e '/^Needs:/,$d'; }

need curl
cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
    enroll) cmd_enroll "$@" ;;
    status) cmd_status ;;
    install) cmd_install "$@" ;;
    adopt) cmd_adopt "$@" ;;
    upgrade|update) cmd_upgrade "$@" ;;
    set) cmd_set "$@" ;;
    license|licence) cmd_license "$@" ;;
    git-credential) cmd_git_credential "$@" ;;
    self-update) cmd_self_update ;;
    version|--version|-v) echo "$VERSION" ;;
    help|--help|-h) usage ;;
    *) die "unknown command '$cmd' (nomalms help)" ;;
esac
